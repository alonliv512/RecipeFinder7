@page "/recipe-search"
@rendermode InteractiveServer

@* דף חיפוש מתכונים לפי רכיבים: שלב עיצובי תצוגתי (שלב 9) *@

<div class="container mt-4">
    <!-- כותרת ראשית מעוצבת -->
    <div class="p-4 mb-4 bg-light rounded-3 shadow-sm border-start border-primary border-5">
        <h1 class="text-primary fw-bold">חיפוש מתכונים לפי רכיבים</h1>
        <p class="text-muted lead mb-0">הזן את המרכיבים שיש לך בבית ומצא אילו מתכונים מעולים תוכל להכין מהם.</p>
    </div>

    <!-- טופס חיפוש לפי רכיבים -->
    <div class="card shadow-sm p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-10">
                <label for="ingredientsInput" class="form-label fw-bold">רכיבים זמינים (הפרד בפסיקים)</label>
                <input type="text" class="form-control" id="ingredientsInput" placeholder="לדוגמה: ביצים, קמח, שוקולד, חלב..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100">חפש לפי רכיבים</button>
            </div>
        </div>
    </div>

     
    <h3 class="text-secondary mb-3">תוצאות מתאימות לרכיבים שלך</h3>
    <div class="row mb-5">
        <div class="col-md-4 mb-3">
            <RecipeCard Title="עוגת גבינה פירורים" Category="קינוחים" Description="עוגת גבינה עשירה וקלה להכנה עם שכבת פירורים פריכה." />
        </div>
        <div class="col-md-4 mb-3">
            <RecipeCard Title="פנקייקורי עננים" Category="ארוחת בוקר" Description="פנקייקים רכים ואווריריים שמוכנים ממוצרים בסיסיים שיש לכולם בבית." />
        </div>
    </div>
</div>
